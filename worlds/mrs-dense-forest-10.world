<?xml version="1.0" ?>
<?xml-model href="http://sdformat.org/schemas/root.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<sdf version="1.5">
  <world name="mrs_dense_forest_10">
    <plugin name="mrs_gazebo_static_transform_republisher_plugin" filename="libMrsGazeboCommonResources_StaticTransformRepublisher.so"/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>47.397743</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.0</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>1000</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-06 2.3e-05 -4.2e-05</magnetic_field>
    </physics>

    <scene>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>250 250 600 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
    </light>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_001</name>
      <pose>1.986238 0.404763 0.000000 0 0 -1.401532</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_002</name>
      <pose>0.000000 0.000000 0.000000 0 0 0.000000</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_003</name>
      <pose>-2.321035 4.749358 0.000000 0 0 -2.405628</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_004</name>
      <pose>0.754366 -0.724326 0.000000 0 0 -1.852761</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_005</name>
      <pose>0.257643 -2.963321 0.000000 0 0 -2.835246</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_006</name>
      <pose>-3.915372 -4.709622 0.000000 0 0 -0.055596</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_007</name>
      <pose>-4.350989 -4.475341 0.000000 0 0 -0.055596</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_008</name>
      <pose>0.027284 -2.633390 0.000000 0 0 -2.444524</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_009</name>
      <pose>-2.091227 -0.923786 0.000000 0 0 0.384187</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_010</name>
      <pose>-2.378709 1.914971 0.000000 0 0 0.963397</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_011</name>
      <pose>-1.143144 3.841885 0.000000 0 0 -0.903485</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_012</name>
      <pose>-3.062804 1.605219 0.000000 0 0 -2.689910</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_013</name>
      <pose>4.685165 3.038776 0.000000 0 0 1.851518</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_014</name>
      <pose>-1.238277 2.144758 0.000000 0 0 -0.140443</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_015</name>
      <pose>3.556717 1.347686 0.000000 0 0 0.462843</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_016</name>
      <pose>3.246999 -2.149990 0.000000 0 0 -2.599724</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_017</name>
      <pose>2.192528 -3.880258 0.000000 0 0 -0.963640</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_018</name>
      <pose>3.050985 0.223972 0.000000 0 0 2.207372</pose>
    </include>

    <include>
      <uri>model://world_jean_tree</uri>
      <name>mrs_dense_forest_10_tree_019</name>
      <pose>-0.665921 -3.660063 0.000000 0 0 0.942517</pose>
    </include>

